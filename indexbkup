        function copyHudSpec(idx) {
            const item = cutsData.filter(i => {
                if (cutState.category !== 'ALL' && i.class !== cutState.category) return false;
                const query = (cutState.searchQuery || '').toLowerCase().trim();
                if (!query) return true;
                return (i.name + ' ' + i.pn + ' ' + i.diameter + ' ' + i.class).toLowerCase().includes(query);
            })[idx];

            if (!item) return;

            let text = `${item.name}\nP/N: ${item.pn}\nDIAMETER: ${item.diameter}\nCLASS: ${item.class}\n`;
            if (item.cut) {
                if (Array.isArray(item.cut)) {
                    item.cut.forEach(c => text += `${c.type}: FREQ: ${c.freq} | SPD: ${c.spd} | PWR: ${c.pwr}\n`);
                } else {
                    text += `Cut: FREQ: ${item.cut.freq} | SPD: ${item.cut.spd} | PWR: ${item.cut.pwr}\n`;
                }
            }
            if (item.engrave && item.engrave.length > 0) {
                item.engrave.forEach(e => text += `${e.type}: FREQ: ${e.freq} | SPD: ${e.spd} | PWR: ${e.pwr}\n`);
            }

            const textArea = document.createElement("textarea");
            textArea.value = text;
            textArea.style.position = "fixed";
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            try {
                document.execCommand('copy');
                showToast(`Copied spec for ${item.name}!`);
                playApogeeNote('G5');
            } catch (err) {
                showToast(`Failed to copy spec.`);
            }
            document.body.removeChild(textArea);
        }

        /* ----------------------------------------------------
           TOAST NOTIFICATION LOGIC
        ---------------------------------------------------- */
        let toastTimer = null;
        function showToast(msg) {
            const banner = document.getElementById('toastBanner');
            document.getElementById('toastMessage').textContent = msg;
            banner.classList.remove('translate-y-20', 'opacity-0');
            banner.classList.add('translate-y-0', 'opacity-100');
            if (toastTimer) clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                banner.classList.add('translate-y-20', 'opacity-0');
                banner.classList.remove('translate-y-0', 'opacity-100');
            }, 2600);
        }

        window.onload = function () {
            loadFromCache();
            renderCuts();
        };
    </script>
</body>
</html>
